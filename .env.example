# Repository-safe example. Copy only the needed keys to:
# ~/.ai-control-center/config.env
AICC_HOST=127.0.0.1
AICC_PORT=4381

# Optional machine-specific overrides
# AICC_STATE_ROOT=/absolute/private/aicc-state
# AICC_WORKSPACE_PROJECTS_ROOT=/absolute/projects/root
# AICC_PYTHON=python3
# AICC_NPM_EXECUTABLE=npm
# AICC_OCX_EXECUTABLE=ocx
# AICC_ACCOUNT_MANAGER_PATH=/absolute/path/to/account-manager
