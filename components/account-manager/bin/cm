#!/usr/bin/env bash
# Codex Account Manager launcher (macOS / Linux / WSL).
# Resolves the repo through symlinks so this file can live on PATH.
set -euo pipefail

target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
  link_dir="$(cd -P "$(dirname "$target")" && pwd)"
  target="$(readlink "$target")"
  case "$target" in
    /*) ;;
    *) target="$link_dir/$target" ;;
  esac
done
cm_repo_root="$(cd -P "$(dirname "$target")/.." && pwd)"

# Requires 3.11+ for tomllib. Prefer the newest interpreter available.
cm_python=""
for candidate in python3.14 python3.13 python3.12 python3.11 python3; do
  if command -v "$candidate" >/dev/null 2>&1; then
    if "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
      cm_python="$candidate"
      break
    fi
  fi
done

if [ -z "$cm_python" ]; then
  echo "Python 3.11 or newer is required (tomllib)." >&2
  exit 127
fi

exec "$cm_python" "$cm_repo_root/src/codex_multi.py" "$@"
