# Runtime secrets and deployment-specific public client settings.
# Copy to the server's protected environment file and chmod 0600.
CM_AUTH_ALLOWED_EMAIL=operator@example.com
CM_AUTH_MAC_TOKEN=replace-with-random-secret
CM_AUTH_EXPECTED_ACCOUNT_ID_SHA256=replace-with-64-lowercase-hex
CM_AUTH_SESSION_SECRET=replace-with-random-secret
CM_AUTH_PUBLIC_ORIGIN=https://cm-auth.example.com
CM_AUTH_FIREBASE_API_KEY=public-web-client-key
CM_AUTH_FIREBASE_PROJECT_ID=example-project
CM_AUTH_FIREBASE_AUTH_DOMAIN=auth.example.com
CM_AUTH_FIREBASE_APP_ID=example-app-id
CM_AUTH_FIREBASE_SENDER_ID=example-sender-id
CM_AUTH_PORTAL_TITLE=Codex Login
CM_AUTH_BIND=127.0.0.1
CM_AUTH_PORT=8110
CM_AUTH_STATE_DIR=/var/lib/cm-auth-broker
CM_AUTH_CODEX_COMMAND=/opt/cm-auth-broker/bin/codex
