# Non-secret machine routing for ops/auth-portal/mac_sync.py.
CM_AUTH_TARGET_ACCOUNT=operator@example.com
CM_AUTH_OCX_TARGET_ACCOUNT=codex-operator
CM_AUTH_PORTAL_URL=https://cm-auth.example.com
CM_AUTH_KEYCHAIN_SERVICE=com.aicc.account-manager.auth-portal
CM_AUTH_OCX_BASE_URL=http://127.0.0.1:10100
# Enable event-driven OCX create/update after a new portal login is stored.
# CM_AUTH_OCX_TARGET_ACCOUNT must be the stable native OCX pool id. For an
# existing slot, use `ocx account list openai --json`; do not invent a new id.
CM_AUTH_SYNC_OPENCODEX=1
