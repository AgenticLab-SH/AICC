<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.codex-account-manager.auth-sync</string>
  <key>ProgramArguments</key><array>
    <string>__CM_LAUNCHER__</string>
    <string>auth-sync</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__NODE_BIN__:__PYTHON_BIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>900</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/cm-auth-sync.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/cm-auth-sync.log</string>
</dict></plist>
